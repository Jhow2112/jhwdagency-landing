---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEOPage from "@/page-components/SEOPage";
import { metaFor, pathFor } from "@/data/routeMeta";

const m = metaFor("/seo-aeo");
---

<BaseLayout
  title={m.title}
  description={m.description}
  path={pathFor(m.route)}
  ogTitle={m.ogTitle}
  ogDescription={m.ogDescription}
  ogImage={m.ogImage}
>
  <SEOPage client:idle />
</BaseLayout>
