---
/* City + industry landing pages — /web-design-{city}/ and /websites-for-{trade}/
   These live at the site root, so this is a root-level dynamic route. Astro
   matches static routes (index.astro, about.astro, …) before dynamic ones, and
   getStaticPaths only emits the 23 landing slugs, so nothing else is affected.

   `slug` in the data carries a leading slash ("/web-design-boise"); Astro
   params must not, hence the strip. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingPageTemplate from "@/components/LandingPageTemplate";
import { CITIES, INDUSTRIES } from "@/data/landingPages";
import { metaFor, pathFor } from "@/data/routeMeta";

export function getStaticPaths() {
  return [...CITIES, ...INDUSTRIES].map((data) => ({
    params: { slug: data.slug.replace(/^\//, "") },
    props: { data },
  }));
}

const { data } = Astro.props;
const m = metaFor(data.slug);
---

<BaseLayout
  title={m.title}
  description={m.description}
  path={pathFor(m.route)}
  ogTitle={m.ogTitle}
  ogDescription={m.ogDescription}
  ogImage={m.ogImage}
>
  <LandingPageTemplate data={data} />
</BaseLayout>
